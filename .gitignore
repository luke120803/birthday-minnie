# Arquivos de Log e Temporários
# =================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Arquivos de Dependências
# ========================
# A pasta node_modules é a mais importante a ser ignorada.
/node_modules

# Arquivos de Build e Saída Compilada
# ====================================
# A pasta 'dist' contém a versão final do seu app para produção.
/dist
/www
/out-tsc

# Cache do Angular
# =================
# Arquivos gerados pelo Angular para acelerar o build.
/.angular/cache

# Arquivos de Sistema Operacional
# ===============================
.DS_Store
Thumbs.db

# Arquivos de Configuração de Editores e IDEs
# ===========================================
# Ignora configurações específicas do seu editor de código (VS Code, WebStorm, etc.)
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Arquivos de Teste e Cobertura de Código
# ========================================
/coverage
/e2e/videos/
/e2e/screenshots/

# Arquivos de Ambiente
# ======================
# Nunca salve senhas ou chaves de API no Git.
.env
.env.local
.env.*.local

# Outros
# =======
/dist-ssr
*.native